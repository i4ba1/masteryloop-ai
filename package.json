{
  "name": "masteryloop-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @masteryloop/web dev",
    "build": "pnpm --filter @masteryloop/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rls": "supabase test db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:types:check": "node scripts/generate-db-types.mjs --check",
    "worker:check": "deno task --config supabase/functions/grading-worker/deno.json check && node scripts/check-worker-graph.mjs",
    "worker:test": "deno task --config supabase/functions/grading-worker/deno.json test",
    "worker:serve": "supabase functions serve grading-worker --env-file supabase/.env.local",
    "bootstrap:verify": "node scripts/verify-bootstrap.mjs",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.116.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "deno": "2.9.6",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "ffmpeg-static": "5.2.0",
    "jsdom": "27.4.0",
    "prettier": "3.8.1",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "zod": "4.3.6"
  }
}
