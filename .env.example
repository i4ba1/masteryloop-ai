# Copy to apps/web/.env.local. Run pnpm setup:local to populate local values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Used only by the local seed/test scripts, never by the browser or web server.
SUPABASE_SERVICE_ROLE_KEY=

# Server only; used exclusively for authorized Auth account creation.
SUPABASE_SERVICE_ROLE_KEY=
# Worker only; generate a random token of at least 32 characters.
WORKER_TRIGGER_TOKEN=
